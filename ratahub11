	--!strict
	--[[
		RATAHUB LOADER V5 (versión inline, sin CanvasGroupholachatgpt2)
		------------------------------------------------------------
		Pega este bloque al inicio de tu script.
		NO es un ModuleScript, NO usa require(), NO retorna nada:
		al terminar este bloque tu script sigue ejecutándose normal.

		USO:
			local Loader = CreateRATAHUBLoader()

			Loader:SetProgress(0.25)
			Loader:SetStatus("Loading...")

			Loader:SetProgress(0.75)
			Loader:SetStatus("Preparing...")

			Loader:Finish() -- no bloquea el script
		------------------------------------------------------------
	]]

	local TweenService = game:GetService("TweenService")
	local Players = game:GetService("Players")

	local LocalPlayer = Players.LocalPlayer
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

	-- ============================================================
	-- CONFIG
	-- ============================================================
	-- Tiempo mínimo que el loader permanece visible desde su creación,
	-- sin contar la animación de salida disparada por Finish().
