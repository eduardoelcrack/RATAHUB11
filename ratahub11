-- Generic notification (replacement for Rayfield:Notify)
function RATAHUB:Notify(cfg)
	cfg = cfg or {}
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Card,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(40, 0),
		ZIndex = 51,
		Parent = notifRoot,
	})
	corner(12, card)
	stroke(card, 0.85, THEME.Primary)
	padding(card, nil, 14, 14, 12, 12)
	create("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = card,
	})
	create("TextLabel", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = cfg.Title or "Notification",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT_BOLD, TextSize = 14,
		ZIndex = 52,
		Parent = card,
	})
	create("TextLabel", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = cfg.Content or "",
		TextColor3 = THEME.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Font = FONT, TextSize = 12,
		ZIndex = 52,
		Parent = card,
	})

	-- enter
	card.BackgroundTransparency = 1
	tween(card, NOTIF_IN, { Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 0 })

	local dismissed = false
	local function dismiss()
		if dismissed then return end
		dismissed = true
		local out = tween(card, NOTIF_OUT, { Position = UDim2.fromOffset(40, 0), BackgroundTransparency = 1 })
		out.Completed:Connect(function()
			card:Destroy()
		end)
	end

	task.delay(cfg.Duration or 3, dismiss)
	return { Dismiss = dismiss }
end

--=====================================================================
-- WINDOW
--=====================================================================
local Window = {}
Window.__index = Window

function RATAHUB:CreateWindow(cfg)
	cfg = cfg or {}

	-- The window is anchored at its CENTER and pinned to the screen centre on
	-- creation. Because the AnchorPoint is (0.5, 0.5), resizing only alters
	-- Size and the window expands/shrinks equally around that centre, and it
	-- starts perfectly centred on any screen resolution. It IS draggable from
	-- the top bar (see the DRAG section below); dragging offsets its Position
	-- without ever changing its Size.
	local window = create("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(START_W, START_H),
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		Parent = screenGui,
	})
	corner(22, window)
	stroke(window, 0.9)

	local self = setmetatable({
		gui = window,
		tabs = {},
		navButtons = {},
		_activeTab = nil,
	}, Window)

	--------------------------------------------------------------
	-- TOP BAR (header — also the drag handle)
	--------------------------------------------------------------
	local topBar = create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, TOPBAR_H),
		BackgroundColor3 = THEME.Sidebar,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = window,
	})
	corner(22, topBar)
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -22),
		BackgroundColor3 = THEME.Sidebar,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = topBar,
	})
	create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = THEME.Stroke,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Parent = topBar,
	})
	padding(topBar, nil, 16, 12, 0, 0)

	local logo = create("Frame", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = THEME.Primary,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Parent = topBar,
	})
	corner(9, logo)
	create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "⬡",
		TextColor3 = THEME.Primary,
		Font = FONT_BOLD, TextSize = 16,
		Parent = logo,
	})
	create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(0, 92, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Title or "RATAHUB",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT_BOLD, TextSize = 15,
		Parent = topBar,
	})
		local badge = create("Frame", {
			Position = UDim2.fromOffset(136, 16),
			Size = UDim2.fromOffset(62, 20),
		BackgroundColor3 = THEME.Secondary,
		BorderSizePixel = 0,
		Parent = topBar,
	})
	corner(6, badge)
	stroke(badge, 0.9)
	create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = cfg.SubTitle or "PREMIUM",
		TextColor3 = THEME.Muted,
		Font = FONT_MONO, TextSize = 10,
		Parent = badge,
	})

	-- Top-right control buttons (minimize / close). Rounded hover background,
	-- press feedback via UIScale, and a destructive tint for Close. They are
	-- TextButtons that sink input, so a click on them never reaches
	-- topBar.InputBegan and therefore never starts a drag.
	local function controlButton(name, symbol, xOffset, hoverColor, hoverText)
		local btn = create("TextButton", {
			Name = name,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = hoverColor,
			BackgroundTransparency = 1,
			Text = symbol,
			TextColor3 = THEME.Muted,
			Font = FONT_BOLD, TextSize = 18,
			AutoButtonColor = false,
			Parent = topBar,
		})
		corner(8, btn)
		local scale = create("UIScale", { Scale = 1, Parent = btn })
		local isDestructive = hoverColor == THEME.Destructive
		btn.MouseEnter:Connect(function()
			tween(btn, HOVER, {
				BackgroundTransparency = isDestructive and 0.1 or 0.85,
				TextColor3 = hoverText,
			})
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, HOVER, { BackgroundTransparency = 1, TextColor3 = THEME.Muted })
			tween(scale, PRESS, { Scale = 1 })
		end)
		btn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				tween(scale, PRESS, { Scale = 0.88 })
			end
		end)
		btn.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				tween(scale, PRESS, { Scale = 1 })
			end
		end)
		return btn
	end

	local body -- forward ref for minimize
	local minimized = false
	local minimizeBtn = controlButton("Minimize", "−", -34, THEME.Secondary, THEME.Foreground)
	local closeBtn = controlButton("Close", "✕", 0, THEME.Destructive, THEME.Foreground)

	closeBtn.MouseButton1Click:Connect(function()
		local t = tween(window, PRESS, { Size = UDim2.fromOffset(window.AbsoluteSize.X, 0) })
		t.Completed:Connect(function()
			screenGui.Enabled = false
		end)
	end)

	--------------------------------------------------------------
	-- RESIZE (center-locked, size-only). The window centre is FIXED
	-- by its AnchorPoint (0.5, 0.5) + Position (0.5, 0.5) scale, so a
	-- resize NEVER touches window.Position — it only sets window.Size.
	-- Each corner captures the mouse and W/H exactly ONCE, then maps
	-- the raw mouse delta (current - original) to a symmetric size
	-- change (×2, because one side moves while the opposite side
	-- expands equally around the fixed centre). Nothing accumulates.
	--------------------------------------------------------------
	-- Shared interaction guard. Dragging and resizing read/write these two
	-- flags so the two systems are strictly mutually exclusive: a resize can
	-- never begin while a drag is active, and a drag can never begin while a
	-- resize is active. They are declared here, ABOVE both systems, so both
	-- close over the exact same booleans.
	local dragActive = false
	local resizeActive = false

	-- signX / signY: how this corner's dx / dy map to width / height.
	--   +1 -> dragging in the positive axis grows the dimension
	--   -1 -> dragging in the positive axis shrinks the dimension
	local CORNERS = {
		{ id = "tl", ax = 0, ay = 0, pos = UDim2.new(0, 0, 0, 0), signX = -1, signY = -1 },
		{ id = "tr", ax = 1, ay = 0, pos = UDim2.new(1, 0, 0, 0), signX =  1, signY = -1 },
		{ id = "bl", ax = 0, ay = 1, pos = UDim2.new(0, 0, 1, 0), signX = -1, signY =  1 },
		{ id = "br", ax = 1, ay = 1, pos = UDim2.new(1, 0, 1, 0), signX =  1, signY =  1 },
	}

	-- Invisible hitbox, sized generously for easy grabbing.
	local HANDLE = 22

	for _, c in ipairs(CORNERS) do
		local handle = create("TextButton", {
			Name = "Resize_" .. c.id,
			Active = true,
			AnchorPoint = Vector2.new(c.ax, c.ay),
			Position = c.pos,
			Size = UDim2.fromOffset(HANDLE, HANDLE),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 30,
			Parent = window,
		})

		local resizing = false
		local origin -- frozen { mouseX, mouseY, width, height }, captured ONCE
		local moveConn, endConn

		local function stopResize()
			resizing = false
			resizeActive = false
			origin = nil
			if moveConn then moveConn:Disconnect() moveConn = nil end
			if endConn then endConn:Disconnect() endConn = nil end
		end

		handle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			-- Resize has priority, but never start one mid-drag.
			if resizing or dragActive then return end
			resizeActive = true

			-- Freeze the mouse position and the current size exactly once.
			-- Every frame measures the delta from THESE frozen values, so the
			-- window can be resized over and over from any corner without any
			-- drift or accumulation.
			origin = {
				mouseX = input.Position.X,
				mouseY = input.Position.Y,
				width = window.AbsoluteSize.X,
				height = window.AbsoluteSize.Y,
			}
			resizing = true

			moveConn = UserInputService.InputChanged:Connect(function(moveInput)
				if not resizing or not origin then return end
				if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
					and moveInput.UserInputType ~= Enum.UserInputType.Touch then
					return
				end

				local dx = moveInput.Position.X - origin.mouseX
				local dy = moveInput.Position.Y - origin.mouseY

				-- ×2 so the window grows/shrinks symmetrically around the
				-- fixed centre while the grabbed corner tracks the cursor.
				local newW = clamp(origin.width  + c.signX * dx * 2, MIN_W, MAX_W)
				local newH = clamp(origin.height + c.signY * dy * 2, MIN_H, MAX_H)

				-- ONLY Size changes. Position is never touched, so the centre
				-- stays exactly put.
				window.Size = UDim2.fromOffset(newW, newH)
			end)

			-- The release is tracked GLOBALLY, not on the handle. The handle is
			-- a tiny hitbox the pointer leaves the instant you start dragging,
			-- so handle.InputEnded would miss the release and leave the move
			-- connection alive. Disconnecting both here guarantees there is
			-- never a leftover resize connection.
			endConn = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == Enum.UserInputType.MouseButton1
					or endInput.UserInputType == Enum.UserInputType.Touch then
					stopResize()
				end
			end)
		end)
	end

	--------------------------------------------------------------
	-- DRAG (top bar only, jump-free). Draggable from the header. The
	-- window keeps its AnchorPoint (0.5, 0.5); it starts centred and
	-- then follows the mouse from wherever it currently is.
	--
	-- Zero-jump principle: on press we snapshot the mouse position and
	-- the window's CURRENT UDim2 exactly once. Every move computes the
	-- absolute delta from that ORIGINAL mouse point and adds it to the
	-- ORIGINAL position — nothing is accumulated frame-to-frame and the
	-- current position is never re-sampled mid-drag, so grabbing the bar
	-- moves the window 1:1 with the cursor with no snap.
	--
	-- The minimize/close controls are TextButtons that sink input, so a
	-- click on them never reaches topBar.InputBegan and never drags.
	--------------------------------------------------------------
	do
		local dragging = false
		local dragStartX, dragStartY   -- mouse position frozen at press
		local startScaleX, startOffX   -- window Position frozen at press
		local startScaleY, startOffY
		local moveConn, endConn

		local function stopDrag()
			dragging = false
			dragActive = false
			if moveConn then moveConn:Disconnect() moveConn = nil end
			if endConn then endConn:Disconnect() endConn = nil end
		end

		topBar.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			-- Never begin a drag while a resize is in progress.
			if dragging or resizeActive then return end

			dragging = true
			dragActive = true
			dragStartX, dragStartY = input.Position.X, input.Position.Y
			local p = window.Position
			startScaleX, startOffX = p.X.Scale, p.X.Offset
			startScaleY, startOffY = p.Y.Scale, p.Y.Offset

			moveConn = UserInputService.InputChanged:Connect(function(moveInput)
				if not dragging then return end
				if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
					and moveInput.UserInputType ~= Enum.UserInputType.Touch then
					return
				end
				-- Delta measured from the ORIGINAL grab point every frame.
				local dx = moveInput.Position.X - dragStartX
				local dy = moveInput.Position.Y - dragStartY
				window.Position = UDim2.new(
					startScaleX, startOffX + dx,
					startScaleY, startOffY + dy
				)
			end)

			-- Global release so a drag that wanders off the top bar still
			-- ends correctly and the connection is always cleaned up.
			endConn = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == Enum.UserInputType.MouseButton1
					or endInput.UserInputType == Enum.UserInputType.Touch then
					stopDrag()
				end
			end)
		end)
	end

	--------------------------------------------------------------
	-- BODY
	--------------------------------------------------------------
	-- Body sits between the top bar and the dedicated footer strip, so its
	-- height reserves BOTH so the scrolling content can never overlap the
	-- footer. Only its Size depends on the window size, so it resizes cleanly.
	body = create("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, TOPBAR_H),
		Size = UDim2.new(1, 0, 1, -(TOPBAR_H + FOOTER_H)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = window,
	})

	-- ---------- SIDEBAR ----------
	local sidebar = create("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, SIDEBAR_W, 1, 0),
		BackgroundColor3 = THEME.Sidebar,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Parent = body,
	})
	create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = THEME.Stroke,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Parent = sidebar,
	})
	padding(sidebar, nil, 14, 14, 18, 14)

	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Text = "MENU",
		TextColor3 = THEME.Muted,
		TextTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Left,
