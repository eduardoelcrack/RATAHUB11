	--=====================================================================
	-- PLAYER & TEAM DYNAMIC CONNECTIONS
	--=====================================================================
	local function refreshAllPlayerDropdowns()
		local list = getPlayerList()
		WHITELIST_TARGETS = list
		if Controls.Main and Controls.Main.HitboxTarget then Controls.Main.HitboxTarget:Refresh(list, false) end
		if Controls.ESP and Controls.ESP.WhitelistTarget then Controls.ESP.WhitelistTarget:Refresh(list, false) end
		if Controls.Aimlock and Controls.Aimlock.WhitelistTarget then Controls.Aimlock.WhitelistTarget:Refresh(list, false) end
		if Controls.Triggerbot and Controls.Triggerbot.WhitelistTarget then Controls.Triggerbot.WhitelistTarget:Refresh(list, false) end
	end

	Players.PlayerAdded:Connect(function(newPlayer)
		task.wait(0.5)
		refreshAllPlayerDropdowns()
	end)

	Players.PlayerRemoving:Connect(function(leftPlayer)
		task.wait(0.2)
		if Config.Main.Player.HitboxTarget == leftPlayer.Name then Config.Main.Player.HitboxTarget = "Nadie" end
		if Config.ESP.WhitelistTarget == leftPlayer.Name then Config.ESP.WhitelistTarget = "Nadie" end
		if Config.Aimlock.WhitelistTarget == leftPlayer.Name then Config.Aimlock.WhitelistTarget = "Nadie" end
		if Config.Triggerbot.WhitelistTarget == leftPlayer.Name then Config.Triggerbot.WhitelistTarget = "Nadie" end

		if Runtime.Aimlock.currentTarget == leftPlayer then
			Features.UnlockAimlock("left", leftPlayer.Name)
		end
		if Runtime.ESP.objects[leftPlayer] then
			local entry = Runtime.ESP.objects[leftPlayer]
			if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
			if entry.Billboard then pcall(function() entry.Billboard:Destroy() end) end
			if entry.Tracer then pcall(function() entry.Tracer:Remove() end) end
			Runtime.ESP.objects[leftPlayer] = nil
		end
		if Runtime.Hitbox.origs[leftPlayer] then
			Features.RestoreHitbox(leftPlayer)
		end

		refreshAllPlayerDropdowns()
	end)

