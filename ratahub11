function Features.ServerHop()
	local want = Config.Main.Utility.TargetServerPlayers
	RATAHUB:Notify({ Title = "Server Finder", Content = "Buscando servidor con " .. want .. " jugadores...", Duration = 3 })
	task.spawn(function()
		local ok, result = pcall(function()
			return HttpService:JSONDecode(game:HttpGet(
				"https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
		end)
		if ok and result and result.data then
			for _, s in ipairs(result.data) do
				if s.playing and s.playing == want and s.id ~= game.JobId then
					TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
					return
				end
			end
			for _, s in ipairs(result.data) do
				if s.playing and s.playing <= want and s.id ~= game.JobId then
					TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player)
					return
				end
			end
			RATAHUB:Notify({ Title = "Server Finder", Content = "No se encontró servidor con esa cantidad", Duration = 3 })
		else
			RATAHUB:Notify({ Title = "Error", Content = "Falló la consulta de servidores", Duration = 2 })
		end
	end)
end

