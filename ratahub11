-- TAB
--=====================================================================
local Tab = {}
Tab.__index = Tab

function Window:CreateTab(cfg)
	cfg = cfg or {}
	local id = cfg.Name and cfg.Name:lower():gsub("%s", "") or ("tab" .. (#self.navButtons + 1))
	local index = 0
	for _ in pairs(self.navButtons) do index += 1 end

	-- nav button
	local btn = create("TextButton", {
		Name = id,
		Position = UDim2.fromOffset(0, index * NAV_ITEM_H),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = THEME.Stroke,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = self._nav,
	})
	corner(10, btn)
	padding(btn, nil, 12, 12, 0, 0)
	local icon = create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		Text = cfg.Icon or "•",
		TextColor3 = THEME.Muted,
		Font = FONT, TextSize = 15,
		Parent = btn,
	})
	local label = create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 30, 0.5, 0),
		Size = UDim2.new(1, -30, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Tab",
		TextColor3 = THEME.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		Parent = btn,
	})

	self.navButtons[id] = { button = btn, icon = icon, label = label, index = index }

	btn.MouseButton1Click:Connect(function()
		self:_select(id)
	end)
	btn.MouseEnter:Connect(function()
		if self._activeTab ~= id then
			tween(btn, HOVER, { BackgroundTransparency = 0.94 })
			tween(icon, HOVER, { TextColor3 = THEME.Foreground })
			tween(label, HOVER, { TextColor3 = THEME.Foreground })
		end
	end)
	btn.MouseLeave:Connect(function()
		if self._activeTab ~= id then
			tween(btn, HOVER, { BackgroundTransparency = 1 })
			tween(icon, HOVER, { TextColor3 = THEME.Muted })
			tween(label, HOVER, { TextColor3 = THEME.Muted })
		end
	end)

	-- page (stacked; only active is visible)
	local page = create("Frame", {
		Name = id .. "_page",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = index,
		Visible = false,
		Parent = self._scroll,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page,
	})

	local tab = setmetatable({
		window = self,
		id = id,
		page = page,
		title = cfg.Name or "Tab",
		subtitle = cfg.SubTitle or "",
		_order = 0,
		_currentCard = nil,
	}, Tab)

	self.tabs[id] = tab

	-- auto-select first tab
	if index == 0 then
		task.defer(function() self:_select(id) end)
	end
	return tab
end

-- internal: next layout order
function Tab:_next()
	self._order += 1
	return self._order
end

-- internal: a card that grows with content
function Tab:_card()
	local c = create("Frame", {
		LayoutOrder = self:_next(),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Card,
		BorderSizePixel = 0,
		Parent = self.page,
	})
	corner(14, c)
	stroke(c, 0.9)
	padding(c, nil, 16, 16, 14, 14)
	create("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		Parent = c,
	})
	c:SetAttribute("Order", 0)
	self._currentCard = c
	return c
end

function Tab:_ensureCard()
	if not self._currentCard then self:_card() end
	return self._currentCard
end

function Tab:_cardOrder(card)
	local o = (card:GetAttribute("Order") or 0) + 1
	card:SetAttribute("Order", o)
	return o
end

-- CreateSection: starts a new card with a section label
function Tab:CreateSection(text)
	local card = self:_card()
	create("TextLabel", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Text = tostring(text or "Section"),
		TextColor3 = THEME.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT_BOLD, TextSize = 11,
		Parent = card,
	})
	return card
end

