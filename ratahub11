		Loader._connections = {} :: { RBXScriptConnection }
		Loader._progressTween = nil :: Tween?
		Loader._glowTween = nil :: Tween?
		Loader._statusTween = nil :: Tween?
		Loader._entranceTweens = {} :: { Tween }
		Loader._ambientTweens = {} :: { Tween }
		Loader._ambientInstances = {} :: { Instance }

		-- ------------------------------------------------------------
