		local col = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = col
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svDot.Position = UDim2.new(s, 0, 1 - v, 0)
		hueDot.Position = UDim2.new(h, 0, 0.5, 0)
		if fireCallback and cfg.Callback then task.spawn(cfg.Callback, col) end
	end

	local function bindDrag(surface, onMove)
		surface.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			onMove(input.Position)
			local moveConn, endConn
			moveConn = UserInputService.InputChanged:Connect(function(moveInput)
				if moveInput.UserInputType == Enum.UserInputType.MouseMovement
					or moveInput.UserInputType == Enum.UserInputType.Touch then
					onMove(moveInput.Position)
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == Enum.UserInputType.MouseButton1
					or endInput.UserInputType == Enum.UserInputType.Touch then
					if moveConn then moveConn:Disconnect() moveConn = nil end
					if endConn then endConn:Disconnect() endConn = nil end
				end
			end)
		end)
	end

	bindDrag(svBtn, function(pos)
		local relX = clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		local relY = clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		s = relX
		v = 1 - relY
		refresh(true)
	end)

	bindDrag(hueBtn, function(pos)
		local relX = clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
		h = relX
		refresh(true)
	end)

	local open = false
	local function setOpen(o)
		open = o
		if open then panel.Visible = true end
		local t = tween(panel, DROP, { Size = UDim2.fromOffset(PANEL_W, open and PANEL_H or 0) })
		if not open then
			t.Completed:Connect(function()
				if not open then panel.Visible = false end
			end)
		end
	end

	preview.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	function handle:Set(newColor)
		if typeof(newColor) ~= "Color3" then return end
		h, s, v = newColor:ToHSV()
		refresh(true)
	end
	function handle:Get() return Color3.fromHSV(h, s, v) end
	return handle
end

