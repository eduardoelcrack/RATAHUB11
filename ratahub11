--=====================================================================
-- CONTROL: TOGGLE  (UIScale overshoot; no layout-size change)
--=====================================================================
function Tab:CreateToggle(cfg)
	cfg = cfg or {}
	local card = self:_ensureCard()
	local state = cfg.CurrentValue and true or false

	local row = create("Frame", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, cfg.Description and 44 or 30),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("TextLabel", {
		Size = UDim2.new(1, -60, 0, 18),
		Position = UDim2.fromOffset(0, cfg.Description and 3 or 6),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Toggle",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		Parent = row,
	})
	if cfg.Description then
		create("TextLabel", {
			Size = UDim2.new(1, -60, 0, 14),
			Position = UDim2.fromOffset(0, 23),
			BackgroundTransparency = 1,
			Text = cfg.Description,
			TextColor3 = THEME.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = FONT, TextSize = 11,
			Parent = row,
		})
	end

	local track = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(44, 24),
		BackgroundColor3 = state and THEME.Primary or THEME.Secondary,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
		corner(12, track)
		local knob = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
		Position = state and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = THEME.Foreground,
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(10, knob)
	local knobScale = create("UIScale", { Scale = 1, Parent = knob })

	local handle = {}
	local function apply(animated)
		local info = animated and TOGGLE or TweenInfo.new(0)
		tween(track, info, { BackgroundColor3 = state and THEME.Primary or THEME.Secondary })
		tween(knob, animated and TOGGLE_KNOB or info,
			{ Position = state and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) })
		if animated then
			-- subtle scale pulse via UIScale (does not affect layout)
			local up = tween(knobScale, PULSE_UP, { Scale = 1.14 })
			up.Completed:Connect(function()
				tween(knobScale, PULSE_DOWN, { Scale = 1 })
			end)
		end
	end

	track.MouseButton1Click:Connect(function()
		state = not state
		apply(true)
		if cfg.Callback then task.spawn(cfg.Callback, state) end
	end)

	function handle:Set(v)
		state = v and true or false
		apply(true)
		if cfg.Callback then task.spawn(cfg.Callback, state) end
	end
	function handle:Get() return state end
	return handle
end

--=====================================================================
-- CONTROL: SLIDER
--=====================================================================
function Tab:CreateSlider(cfg)
	cfg = cfg or {}
	local card = self:_ensureCard()
	local minV = cfg.Range and cfg.Range[1] or 0
	local maxV = cfg.Range and cfg.Range[2] or 100
	local inc = cfg.Increment or 1
	local suffix = cfg.Suffix or ""
	local value = clamp(cfg.CurrentValue or minV, minV, maxV)

	local row = create("Frame", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("TextLabel", {
		Size = UDim2.new(1, -80, 0, 16),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Slider",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		Parent = row,
	})
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(80, 16),
		BackgroundTransparency = 1,
		Text = tostring(value) .. suffix,
		TextColor3 = THEME.Primary,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = FONT_MONO, TextSize = 13,
		Parent = row,
	})

	local track = create("TextButton", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = THEME.Secondary,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(3, track)
	local function pct() return (value - minV) / (maxV - minV) end
	local fill = create("Frame", {
		Size = UDim2.fromScale(pct(), 1),
		BackgroundColor3 = THEME.Primary,
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(3, fill)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(pct(), 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = THEME.Foreground,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	})
	corner(7, knob)

	local handle = {}
	local dragging = false
	local moveConn, endConn

	local function render()
		local p = pct()
		fill.Size = UDim2.fromScale(p, 1)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
		valueLabel.Text = tostring(value) .. suffix
	end
	local function setFromX(px)
		local rel = clamp((px - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local raw = minV + rel * (maxV - minV)
		value = clamp(math.floor((raw / inc) + 0.5) * inc, minV, maxV)
		render()
		if cfg.Callback then task.spawn(cfg.Callback, value) end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(knob, HOVER, { Size = UDim2.fromOffset(18, 18) })
			setFromX(input.Position.X)

			moveConn = UserInputService.InputChanged:Connect(function(moveInput)
				if dragging and (moveInput.UserInputType == Enum.UserInputType.MouseMovement
					or moveInput.UserInputType == Enum.UserInputType.Touch) then
					setFromX(moveInput.Position.X)
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == Enum.UserInputType.MouseButton1
					or endInput.UserInputType == Enum.UserInputType.Touch then
					dragging = false
					tween(knob, HOVER, { Size = UDim2.fromOffset(14, 14) })
					if moveConn then moveConn:Disconnect() moveConn = nil end
					if endConn then endConn:Disconnect() endConn = nil end
				end
			end)
		end
	end)

	function handle:Set(v)
		-- Respect Range and Increment exactly like a user drag would.
		local raw = clamp(v, minV, maxV)
		value = clamp(math.floor((raw / inc) + 0.5) * inc, minV, maxV)
		render()
		if cfg.Callback then task.spawn(cfg.Callback, value) end
	end
	function handle:Get() return value end
	return handle
end

