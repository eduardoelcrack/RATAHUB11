function Features.StartFreecam()
	if Runtime.Camera.freecamLoop then return end
	local cam = workspace.CurrentCamera
	if not cam then return end

	local root = getRoot()
	if root then
		Runtime.Camera.wasAnchored = root.Anchored
		root.Anchored = true
	end

	Runtime.Camera.savedType = cam.CameraType
	Runtime.Camera.savedSubject = cam.CameraSubject
	cam.CameraType = Enum.CameraType.Scriptable

	local keys = Runtime.Camera.keys
	table.clear(keys)

	Runtime.Camera.freecamBegan = UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			keys[input.KeyCode] = true
		end
	end)
	Runtime.Camera.freecamEnded = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			keys[input.KeyCode] = nil
		end
	end)

	Runtime.Camera.freecamLoop = RunService.RenderStepped:Connect(function(dt)
		local c = workspace.CurrentCamera
		if not c then return end
		local move = Vector3.zero
		if keys[Enum.KeyCode.W] then move += Vector3.new(0, 0, -1) end
		if keys[Enum.KeyCode.S] then move += Vector3.new(0, 0, 1) end
		if keys[Enum.KeyCode.A] then move += Vector3.new(-1, 0, 0) end
		if keys[Enum.KeyCode.D] then move += Vector3.new(1, 0, 0) end
		if keys[Enum.KeyCode.E] then move += Vector3.new(0, 1, 0) end
		if keys[Enum.KeyCode.Q] then move += Vector3.new(0, -1, 0) end

		local speedMultiplier = Config.Extras.Camera.FreecamSpeed or 10
		local speed = (keys[Enum.KeyCode.LeftShift] and (speedMultiplier * 5) or (speedMultiplier * 2)) * dt * 10
		c.CFrame = c.CFrame * CFrame.new(move * speed)
	end)
end

function Features.StopFreecam()
	if Runtime.Camera.freecamLoop then Runtime.Camera.freecamLoop:Disconnect() Runtime.Camera.freecamLoop = nil end
	if Runtime.Camera.freecamBegan then Runtime.Camera.freecamBegan:Disconnect() Runtime.Camera.freecamBegan = nil end
	if Runtime.Camera.freecamEnded then Runtime.Camera.freecamEnded:Disconnect() Runtime.Camera.freecamEnded = nil end
	table.clear(Runtime.Camera.keys)

	local root = getRoot()
	if root then
		root.Anchored = Runtime.Camera.wasAnchored or false
	end

	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Runtime.Camera.savedType or Enum.CameraType.Custom
		if Runtime.Camera.savedSubject then
			cam.CameraSubject = Runtime.Camera.savedSubject
		else
			local hum = getHumanoid()
			if hum then cam.CameraSubject = hum end
		end
	end
end

