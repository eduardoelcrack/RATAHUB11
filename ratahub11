	local currentKey = cfg.CurrentKeybind or "None"

	local row = create("Frame", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -110, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Keybind",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		Parent = row,
	})
	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(100, 28),
		BackgroundColor3 = THEME.Secondary,
		Text = tostring(currentKey),
		TextColor3 = THEME.Foreground,
		Font = FONT_MONO, TextSize = 12,
		AutoButtonColor = false,
		Parent = row,
	})
	corner(8, btn)
	stroke(btn, 0.9)
	attachInteract(btn, { hover = 1.03, press = 0.96 })

	local handle = {}
	local listening = false
	local captureConn

	local function stopListening()
		listening = false
		if captureConn then captureConn:Disconnect() captureConn = nil end
	end

	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		btn.Text = "Press a key..."
		tween(btn, HOVER, { BackgroundColor3 = THEME.Primary })
		btn.TextColor3 = THEME.PrimaryText

		captureConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end

			if input.KeyCode == Enum.KeyCode.Escape then
				stopListening()
				btn.Text = tostring(currentKey)
				tween(btn, HOVER, { BackgroundColor3 = THEME.Secondary })
				btn.TextColor3 = THEME.Foreground
				return
			end

			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
				currentKey = input.KeyCode.Name
				stopListening()
				btn.Text = currentKey
				tween(btn, HOVER, { BackgroundColor3 = THEME.Secondary })
				btn.TextColor3 = THEME.Foreground
				if cfg.Callback then task.spawn(cfg.Callback, input.KeyCode) end
			end
		end)
	end)

	function handle:Set(keyName)
		if typeof(keyName) == "EnumItem" then
			keyName = keyName.Name
		end
		currentKey = keyName
		btn.Text = tostring(keyName)
	end
	function handle:Get() return currentKey end
	return handle
end

