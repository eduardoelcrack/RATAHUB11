	end
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)
	if Config.Main.Player.HitboxTarget == leavingPlayer.Name then
		Config.Main.Player.HitboxTarget = "Nadie"
	end
	local list = getPlayerList()
	if Controls.Main.HitboxTarget then
		Controls.Main.HitboxTarget:Refresh(list, false)
		if Config.Main.Player.HitboxTarget == "Nadie" then
			Controls.Main.HitboxTarget:Set("Nadie")
		end
	end
end)

