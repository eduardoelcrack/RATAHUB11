	local function GiveClickTPTool()
		local backpack = player:FindFirstChildOfClass("Backpack")
		local char = player.Character
		if not backpack or not char then return end
		if not backpack:FindFirstChild("Click TP") and not char:FindFirstChild("Click TP") then
			local tool = Instance.new("Tool")
			tool.RequiresHandle = false
			tool.Name = "Click TP"
			tool.ToolTip = "Haz click en cualquier lado para teletransportarte"

			tool.Activated:Connect(function()
				local mouse = player:GetMouse()
				if not mouse then return end
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { player.Character }

				local unitRay = mouse.UnitRay
				local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, params)
				local targetPos = rayResult and rayResult.Position or (mouse.Hit and mouse.Hit.Position)

				if targetPos and player.Character then
					local root = player.Character:FindFirstChild("HumanoidRootPart")
					if root then
						player.Character:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))
					end
				end
			end)

			tool.Parent = backpack
		end
	end

	local function RemoveClickTPTool()
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack and backpack:FindFirstChild("Click TP") then
			pcall(function() backpack["Click TP"]:Destroy() end)
		end
		local char = player.Character
		if char and char:FindFirstChild("Click TP") then
			pcall(function() char["Click TP"]:Destroy() end)
		end
	end

	-- =============================================================================
	-- BTOOLS MAP & DELETED INSTANCES RESTORER (CLONE-BASED 100% RELIABLE)
	-- =============================================================================
	local DeletedPartsCache = {}

	local function GiveBToolsTool()
		local backpack = player:FindFirstChildOfClass("Backpack")
		local char = player.Character
		if not backpack or not char then return end
		if not backpack:FindFirstChild("BTools") and not char:FindFirstChild("BTools") then
			local tool = Instance.new("Tool")
			tool.RequiresHandle = false
			tool.Name = "BTools"
			tool.ToolTip = "Click en cualquier pared u objeto para borrarlo (Client-side)"

			tool.Activated:Connect(function()
				local mouse = player:GetMouse()
				local target = mouse and mouse.Target
				if target and target:IsA("BasePart") and not target:IsDescendantOf(player.Character) then
					local isPlayer = false
					for _, p in ipairs(Players:GetPlayers()) do
						if p.Character and target:IsDescendantOf(p.Character) then
							isPlayer = true
							break
						end
					end

					if not isPlayer and target.Parent then
						pcall(function() target.Archivable = true end)
						local success, clone = pcall(function() return target:Clone() end)
						if success and clone then
							pcall(function() clone.Archivable = true end)
							table.insert(DeletedPartsCache, {
								Clone = clone,
								OriginalParent = target.Parent,
								CFrame = target.CFrame
							})
							if #DeletedPartsCache > 2000 then
								table.remove(DeletedPartsCache, 1)
							end
						end
						pcall(function() target:Destroy() end)
					end
				end
			end)

			tool.Parent = backpack
		end
	end

	local function RemoveBToolsTool()
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") and item.Name == "BTools" then
					pcall(function() item:Destroy() end)
				end
				if item:IsA("HopperBin") and (item.Name == "BTools" or item.BinType == Enum.BinType.Hammer) then
					pcall(function() item:Destroy() end)
				end
			end
		end
		local char = player.Character
		if char then
			for _, item in ipairs(char:GetChildren()) do
				if item:IsA("Tool") and item.Name == "BTools" then
					pcall(function() item:Destroy() end)
				end
				if item:IsA("HopperBin") and (item.Name == "BTools" or item.BinType == Enum.BinType.Hammer) then
					pcall(function() item:Destroy() end)
				end
			end
		end
	end

