		-- Divisor (estático: el detalle animado vive en el spinner y la barra)
		local divider = Instance.new("Frame")
		divider.Name = "Divider"
		divider.BackgroundColor3 = RATAHUB_LOADER_COLORS.Accent
		divider.BackgroundTransparency = 0.55
		divider.BorderSizePixel = 0
		divider.Size = UDim2.new(1, 0, 0, 1)
		divider.ZIndex = 3
		divider.LayoutOrder = 2
		divider.Parent = panel

		local dividerGradient = Instance.new("UIGradient")
		dividerGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		dividerGradient.Parent = divider

		-- ------------------------------------------------------------
		-- Fila de estado: spinner + texto (con puntos animados incluidos)
		-- ------------------------------------------------------------
		local statusRow = Instance.new("Frame")
		statusRow.Name = "StatusRow"
		statusRow.BackgroundTransparency = 1
		statusRow.Size = UDim2.new(1, 0, 0, 18)
		statusRow.ZIndex = 3
		statusRow.LayoutOrder = 3
		statusRow.Parent = panel

		local statusLayout = Instance.new("UIListLayout")
		statusLayout.FillDirection = Enum.FillDirection.Horizontal
		statusLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		statusLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		statusLayout.Padding = UDim.new(0, 8)
		statusLayout.SortOrder = Enum.SortOrder.LayoutOrder
		statusLayout.Parent = statusRow

		-- Spinner: un anillo (UIStroke circular) con un UIGradient que
		-- deja dos huecos transparentes. Al rotar el gradiente, el hueco
		-- se desplaza alrededor del anillo y se percibe como un arco
		-- girando. El efecto se aplica directamente sobre el UIStroke
		-- del propio "spinner" (son hermanos dentro del mismo Frame).
		local spinner = Instance.new("Frame")
		spinner.Name = "Spinner"
		spinner.BackgroundTransparency = 1
		spinner.Size = UDim2.fromOffset(14, 14)
		spinner.ZIndex = 4
		spinner.LayoutOrder = 1
		spinner.Parent = statusRow

		local spinnerCorner = Instance.new("UICorner")
		spinnerCorner.CornerRadius = UDim.new(1, 0)
		spinnerCorner.Parent = spinner

		local spinnerStroke = Instance.new("UIStroke")
		spinnerStroke.Thickness = 2
		spinnerStroke.Color = RATAHUB_LOADER_COLORS.Accent
		spinnerStroke.Transparency = 0
		spinnerStroke.Parent = spinner

		local spinnerGradient = Instance.new("UIGradient")
		spinnerGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(1, 0),
		})
		spinnerGradient.Parent = spinner

		local status = Instance.new("TextLabel")
		status.Name = "Status"
		status.BackgroundTransparency = 1
		status.AutomaticSize = Enum.AutomaticSize.X
		status.Size = UDim2.new(0, 0, 1, 0)
		status.Font = Enum.Font.Gotham
		status.Text = "Initializing"
		status.TextSize = 14
		status.TextColor3 = RATAHUB_LOADER_COLORS.TextMain
		status.TextTransparency = 0.15
		status.ZIndex = 4
		status.LayoutOrder = 2
		status.Parent = statusRow

		-- ------------------------------------------------------------
		-- Barra de progreso
		-- ------------------------------------------------------------
		local barContainer = Instance.new("Frame")
		barContainer.Name = "BarContainer"
		barContainer.BackgroundTransparency = 1
		barContainer.Size = UDim2.new(1, 0, 0, 26)
		barContainer.ZIndex = 3
		barContainer.LayoutOrder = 4
		barContainer.Parent = panel

		local barBg = Instance.new("Frame")
		barBg.Name = "BarBackground"
		barBg.BackgroundColor3 = RATAHUB_LOADER_COLORS.Secondary
		barBg.ClipsDescendants = true
		barBg.Size = UDim2.new(1, 0, 0, 8)
		barBg.Position = UDim2.new(0, 0, 0, 0)
		barBg.BorderSizePixel = 0
		barBg.ZIndex = 3
		barBg.Parent = barContainer

		local barBgCorner = Instance.new("UICorner")
		barBgCorner.CornerRadius = UDim.new(1, 0)
		barBgCorner.Parent = barBg

		local barFill = Instance.new("Frame")
		barFill.Name = "BarFill"
		barFill.BackgroundColor3 = RATAHUB_LOADER_COLORS.Accent
		barFill.Size = UDim2.new(0, 0, 1, 0)
		barFill.BorderSizePixel = 0
		barFill.ZIndex = 5
		barFill.Parent = barBg

		local barFillCorner = Instance.new("UICorner")
		barFillCorner.CornerRadius = UDim.new(1, 0)
		barFillCorner.Parent = barFill

		local barFillGradient = Instance.new("UIGradient")
		barFillGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, RATAHUB_LOADER_COLORS.AccentDim),
			ColorSequenceKeypoint.new(1, RATAHUB_LOADER_COLORS.Accent),
		})
		barFillGradient.Parent = barFill

		local percentLabel = Instance.new("TextLabel")
		percentLabel.Name = "Percent"
		percentLabel.BackgroundTransparency = 1
		percentLabel.AnchorPoint = Vector2.new(1, 0)
		percentLabel.Position = UDim2.new(1, 0, 0, 12)
		percentLabel.Size = UDim2.new(0, 60, 0, 16)
		percentLabel.Font = Enum.Font.GothamMedium
		percentLabel.Text = "0%"
		percentLabel.TextSize = 13
		percentLabel.TextColor3 = RATAHUB_LOADER_COLORS.TextSub
		percentLabel.TextTransparency = 0
		percentLabel.TextXAlignment = Enum.TextXAlignment.Right
		percentLabel.ZIndex = 4
		percentLabel.Parent = barContainer

		-- ------------------------------------------------------------
		-- Porcentaje sincronizado con el tween de la barra.
		-- Basado en evento (GetPropertyChangedSignal), no en polling.
		-- ------------------------------------------------------------
		local percentConnection = barFill:GetPropertyChangedSignal("Size"):Connect(function()
			local ratio = barFill.Size.X.Scale
			percentLabel.Text = string.format("%d%%", math.floor(ratio * 100 + 0.5))
			if ratio >= 1 and percentLabel.TextColor3 ~= RATAHUB_LOADER_COLORS.Accent then
				TweenService:Create(percentLabel, TweenInfo.new(0.25), { TextColor3 = RATAHUB_LOADER_COLORS.Accent }):Play()
			end
		end)
		table.insert(Loader._connections, percentConnection)

		-- ------------------------------------------------------------
		-- Único par de animaciones ambientales infinitas: el spinner
		-- (indica actividad) y los puntos suspensivos del status. Ambas
		-- son baratas, cancelables y se destruyen en Destroy().
		-- ------------------------------------------------------------
		local dotsValue = Instance.new("NumberValue")
		dotsValue.Value = 0
		table.insert(Loader._ambientInstances, dotsValue)

		local dotsConnection = dotsValue:GetPropertyChangedSignal("Value"):Connect(function()
			local count = math.floor(dotsValue.Value) % 4
			status.Text = Loader._statusBase .. string.rep(".", count)
		end)
		table.insert(Loader._connections, dotsConnection)

		local dotsTween = TweenService:Create(
			dotsValue,
			TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false),
			{ Value = 4 }
		)
		table.insert(Loader._ambientTweens, dotsTween)
		dotsTween:Play()

		local spinnerTween = TweenService:Create(
			spinnerGradient,
			TweenInfo.new(0.85, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false),
			{ Rotation = 360 }
		)
		table.insert(Loader._ambientTweens, spinnerTween)
		spinnerTween:Play()

		-- ------------------------------------------------------------
		-- Animación de entrada: Fade In + Scale In
		-- ------------------------------------------------------------
		local fadeInBackdrop = TweenService:Create(
			backdrop,
			TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0.15 }
		)
		local fadeInShadow = TweenService:Create(
			shadow,
			TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0.8 }
		)
		local scaleIn = TweenService:Create(
			uiScale,
			TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		)
		table.insert(Loader._entranceTweens, fadeInBackdrop)
		table.insert(Loader._entranceTweens, fadeInShadow)
		table.insert(Loader._entranceTweens, scaleIn)

		fadeInBackdrop:Play()
		fadeInShadow:Play()
		scaleIn:Play()

		-- ------------------------------------------------------------
		-- API pública
		-- ------------------------------------------------------------
		function Loader:SetProgress(value: number)
			if self._state ~= "Loading" then
				return
			end
			value = math.clamp(value, 0, 1)

			if self._progressTween then
				self._progressTween:Cancel()
			end

			-- La duración es proporcional al salto: se nota claramente
			-- cómo la barra recorre el camino hasta el nuevo valor en
			-- lugar de saltar de golpe.
			local currentRatio = barFill.Size.X.Scale
			local delta = math.abs(value - currentRatio)
			local duration = math.clamp(delta * 2.8, 0.8, 3.6)

			local tween = TweenService:Create(
				barFill,
				TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ Size = UDim2.new(value, 0, 1, 0) }
			)
			self._progressTween = tween
			tween:Play()

			-- Glow del borde del panel: entre más avanza el progreso, el
			-- borde de acento se vuelve más opaco, más grueso y más
			-- brillante (se acerca a blanco). Va sincronizado con la
			-- misma duración que la barra para que se sienta como una
			-- sola cosa.
			if self._glowTween then
				self._glowTween:Cancel()
			end
			local glowTransparency = 0.75 - (0.7 * value)
			local glowThickness = 1 + (1.6 * value)
			local glowColor = RATAHUB_LOADER_COLORS.Accent:Lerp(Color3.fromRGB(200, 232, 255), value)
			local glowTween = TweenService:Create(
				panelStroke,
				TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ Transparency = glowTransparency, Thickness = glowThickness, Color = glowColor }
			)
			self._glowTween = glowTween
			glowTween:Play()
		end

		function Loader:SetStatus(text: string)
			if self._state ~= "Loading" then
				return
			end

			if self._statusTween then
				self._statusTween:Cancel()
			end

			local fadeOut = TweenService:Create(
				status,
				TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ TextTransparency = 1 }
			)
			self._statusTween = fadeOut
			fadeOut:Play()

			fadeOut.Completed:Once(function()
				-- Aunque Finish() ya haya entrado en "Finishing", dejamos
				-- que este fade termine su ciclo (fade-in incluido) para
				-- que el texto nunca se quede pegado en invisible. Solo
				-- abortamos si el Loader ya fue destruido del todo.
				if self._state == "Destroyed" then
					return
				end
				self._statusBase = text
				status.Text = text
				local fadeIn = TweenService:Create(
					status,
					TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextTransparency = 0.15 }
				)
				self._statusTween = fadeIn
				fadeIn:Play()
			end)
		end

		-- ------------------------------------------------------------
		-- Finish(): no bloquea el script que lo llama.
		-- Respeta el tiempo mínimo visible desde la creación y luego
		-- ejecuta, en aprox. 0.8-1.2s: Ready -> 100% -> Fade Out -> Destroy.
		-- ------------------------------------------------------------
		function Loader:Finish()
			if self._state ~= "Loading" then
				return
			end
			self._state = "Finishing"

			task.spawn(function()
				local elapsed = os.clock() - self._createdAt
				local remaining = RATAHUB_LOADER_MIN_VISIBLE_TIME - elapsed
				if remaining > 0 then
					task.wait(remaining)
				end

				-- Si la barra todavía está en movimiento hacia el valor
				-- que le mandaron por SetProgress, la dejamos terminar su
				-- propio recorrido en vez de cortarla a medias: cancelarla
				-- a mitad de camino y arrancar otra tween más corta es lo
				-- que se sentía como un "impulso" repentino de velocidad.
				if self._progressTween and self._progressTween.PlaybackState == Enum.PlaybackState.Playing then
					self._progressTween.Completed:Wait()
				end

				-- Detiene todo lo ambiental/entrada/estado.
				for _, tween in ipairs(self._entranceTweens) do
					pcall(function()
						tween:Cancel()
					end)
				end
				for _, tween in ipairs(self._ambientTweens) do
					pcall(function()
						tween:Cancel()
					end)
				end
				if self._progressTween then
					self._progressTween:Cancel()
				end
				if self._glowTween then
					self._glowTween:Cancel()
				end
				if self._statusTween then
					self._statusTween:Cancel()
				end

				-- El texto cambia de ancho al pasar a "Ready" (string más
				-- corto). Para que ese reacomodo del layout no se note,
				-- lo hacemos desaparecer, lo cambiamos mientras es
				-- invisible, y lo regresamos ya en su posición final.
				local readyFadeOut = TweenService:Create(
					status,
					TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextTransparency = 1 }
				)
				self._statusTween = readyFadeOut
				readyFadeOut:Play()
				readyFadeOut.Completed:Wait()

				self._statusBase = "Ready"
				status.Text = "Ready"

				local readyFadeIn = TweenService:Create(
					status,
					TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextTransparency = 0 }
				)
				self._statusTween = readyFadeIn
				readyFadeIn:Play()

				-- El spinner ya cumplió su función: en vez de quedarse
				-- congelado a medio giro (se ve como un anillo roto),
				-- se desvanece limpio apenas entramos a "Ready".
				TweenService:Create(
					spinnerStroke,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Transparency = 1 }
				):Play()

				local completeDelta = math.abs(1 - barFill.Size.X.Scale)
				local completeDuration = math.clamp(completeDelta * 1.1, 0.2, 0.45)
				local completeTween = TweenService:Create(
					barFill,
					TweenInfo.new(completeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Size = UDim2.new(1, 0, 1, 0) }
				)
				completeTween:Play()
				completeTween.Completed:Wait()

				TweenService:Create(percentLabel, TweenInfo.new(0.2), { TextColor3 = RATAHUB_LOADER_COLORS.Accent }):Play()

				task.wait(0.15)

				-- Fade Out + Scale Out de cada elemento, en paralelo.
				local fadeDuration = 0.32
				local fadeTargets: { Tween } = {
					TweenService:Create(backdrop, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(shadow, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(panel, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }),
					TweenService:Create(panelStroke, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }),
					TweenService:Create(uiScale, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.92 }),
