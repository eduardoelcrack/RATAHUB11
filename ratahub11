local HOVER      = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local PRESS      = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TOGGLE     = TweenInfo.new(0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TOGGLE_KNOB= TweenInfo.new(0.20, Enum.EasingStyle.Back, Enum.EasingDirection.Out) -- subtle overshoot
local PULSE_UP   = TweenInfo.new(0.09, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local PULSE_DOWN = TweenInfo.new(0.13, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local SLIDE      = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local DROP       = TweenInfo.new(0.20, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
local NOTIF_IN   = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local NOTIF_OUT  = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

--=====================================================================
-- SMALL HELPERS
--=====================================================================
local function create(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius, parent)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

local function stroke(parent, transparency, color, thickness)
	return create("UIStroke", {
		Color = color or THEME.Stroke,
		Transparency = transparency == nil and 0.9 or transparency,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function padding(parent, all, l, r, t, b)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, l or all or 0),
		PaddingRight = UDim.new(0, r or all or 0),
		PaddingTop = UDim.new(0, t or all or 0),
		PaddingBottom = UDim.new(0, b or all or 0),
		Parent = parent,
	})
end

local function tween(inst, info, goal)
	local t = TweenService:Create(inst, info, goal)
	t:Play()
	return t
end

local function clamp(v, lo, hi)
	return math.min(hi, math.max(lo, v))
end

-- Adds a UIScale and wires hover/press feedback (no layout size change).
local function attachInteract(button, opts)
	opts = opts or {}
	local hoverScale = opts.hover or 1.02
	local pressScale = opts.press or 0.97
	local scale = create("UIScale", { Scale = 1, Parent = button })
	local hovered = false

	button.MouseEnter:Connect(function()
		hovered = true
		tween(scale, HOVER, { Scale = hoverScale })
		if opts.onHover then opts.onHover(true) end
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		tween(scale, HOVER, { Scale = 1 })
		if opts.onHover then opts.onHover(false) end
	end)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			tween(scale, PRESS, { Scale = pressScale })
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			tween(scale, PRESS, { Scale = hovered and hoverScale or 1 })
		end
	end)
	return scale
end

