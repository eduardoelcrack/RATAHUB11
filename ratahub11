------------------------------------------------------------- Extras: Performance (FPS Boost / Anti-Fling)
function Features.SetFPSBoost(enabled)
	if enabled then
		pcall(function()
			Runtime.Performance.savedLighting = Runtime.Performance.savedLighting or {
				GlobalShadows = Lighting.GlobalShadows,
				FogEnd = Lighting.FogEnd,
			}
			Runtime.Performance.savedParticles = Runtime.Performance.savedParticles or {}
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
					or obj:IsA("Fire") or obj:IsA("Sparkles") then
					if obj.Enabled then
						Runtime.Performance.savedParticles[obj] = true
						obj.Enabled = false
					end
				end
			end
		end)
		RATAHUB:Notify({ Title = "FPS Boost", Content = "Activado", Duration = 1.5 })
	else
		pcall(function()
			local s = Runtime.Performance.savedLighting
			if s then
				Lighting.GlobalShadows = s.GlobalShadows
				Lighting.FogEnd = s.FogEnd
				Runtime.Performance.savedLighting = nil
			end
			if Runtime.Performance.savedParticles then
				for obj, wasEnabled in pairs(Runtime.Performance.savedParticles) do
					if obj and obj.Parent and wasEnabled then
						obj.Enabled = true
					end
				end
				table.clear(Runtime.Performance.savedParticles)
			end
		end)
		RATAHUB:Notify({ Title = "FPS Boost", Content = "Desactivado", Duration = 1.2 })
	end
end

function Features.SetAntiFling(enabled)
	if enabled then
		if Runtime.Performance.antiFlingConn then return end
		Runtime.Performance.antiFlingConn = RunService.Stepped:Connect(function()
			local root = getRoot()
			if root then
				if root.AssemblyAngularVelocity.Magnitude > 50 then
					root.AssemblyAngularVelocity = Vector3.zero
				end
				local lv = root.AssemblyLinearVelocity
				if lv.Magnitude > 250 then
					root.AssemblyLinearVelocity = Vector3.new(0, lv.Y, 0)
				end
			end
		end)
		RATAHUB:Notify({ Title = "Anti-Fling", Content = "Activado", Duration = 1.2 })
	else
		if Runtime.Performance.antiFlingConn then
			Runtime.Performance.antiFlingConn:Disconnect()
			Runtime.Performance.antiFlingConn = nil
		end
		RATAHUB:Notify({ Title = "Anti-Fling", Content = "Desactivado", Duration = 1.2 })
	end
end

