	-- =============================================================================
	-- ULTRA-FAST ZERO-LAG ASYNC FRIENDS CACHE & DYNAMIC IN-GAME STATUS
	-- =============================================================================
	local FriendsCache = {}

	local function CheckPlayerIsFriend(p)
		if not p or p == player then return false end
		local s1, status = pcall(function() return player:GetFriendStatus(p) end)
		if s1 and (status == Enum.FriendStatus.Friend or status == Enum.FriendStatus.FriendRequestSent) then
			return true
		end
		local s2, isF = pcall(function() return player:IsFriendsWith(p.UserId) end)
		if s2 and isF then
			return true
		end
		local s3, isF2 = pcall(function() return p:IsFriendsWith(player.UserId) end)
		if s3 and isF2 then
			return true
		end
		return false
	end

	function Features.RefreshAllFriends()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				task.spawn(function()
					local isF = CheckPlayerIsFriend(p)
					FriendsCache[p] = isF
					FriendsCache[p.UserId] = isF
					FriendsCache[p.Name] = isF
				end)
			end
		end
	end

	local function CacheFriendStatus(p)
		if not p or p == player then return end
		task.spawn(function()
			local isF = CheckPlayerIsFriend(p)
			FriendsCache[p] = isF
			FriendsCache[p.UserId] = isF
			FriendsCache[p.Name] = isF
		end)
	end

	for _, p in ipairs(Players:GetPlayers()) do
		CacheFriendStatus(p)
	end

	Players.PlayerAdded:Connect(function(p)
		CacheFriendStatus(p)
	end)

	Players.PlayerRemoving:Connect(function(p)
		FriendsCache[p] = nil
		FriendsCache[p.UserId] = nil
		FriendsCache[p.Name] = nil
	end)

	pcall(function()
		player.FriendStatusChanged:Connect(function(otherPlayer, friendStatus)
			local isF = (friendStatus == Enum.FriendStatus.Friend or friendStatus == Enum.FriendStatus.FriendRequestSent)
			FriendsCache[otherPlayer] = isF
			FriendsCache[otherPlayer.UserId] = isF
			FriendsCache[otherPlayer.Name] = isF
		end)
	end)

	-- Event-driven friend status tracking (Zero lag, zero background polling)
	pcall(function()
		player.FriendStatusChanged:Connect(function(otherPlayer, friendStatus)
			local isF = (friendStatus == Enum.FriendStatus.Friend or friendStatus == Enum.FriendStatus.FriendRequestSent)
			FriendsCache[otherPlayer] = isF
			FriendsCache[otherPlayer.UserId] = isF
			FriendsCache[otherPlayer.Name] = isF
		end)
	end)

	function Features.IsFriend(targetPlayer)
		if not targetPlayer or targetPlayer == player then return false end
		if FriendsCache[targetPlayer] ~= nil then
			return FriendsCache[targetPlayer]
		end
		if FriendsCache[targetPlayer.UserId] ~= nil then
			return FriendsCache[targetPlayer.UserId]
		end
		if FriendsCache[targetPlayer.Name] ~= nil then
			return FriendsCache[targetPlayer.Name]
		end
		CacheFriendStatus(targetPlayer)
		return false
	end

	function Features.IsTeamIgnored(targetPlayer, ignoredTeams)
		if not targetPlayer or not targetPlayer.Team then return false end
		local teamName = targetPlayer.Team.Name
		if type(ignoredTeams) == "table" then
			if ignoredTeams[teamName] == true then return true end
			for k, v in pairs(ignoredTeams) do
				if v == teamName or (k == teamName and v == true) then
					return true
				end
			end
		elseif type(ignoredTeams) == "string" and ignoredTeams ~= "" and ignoredTeams ~= "Ninguno" then
			return ignoredTeams == teamName
		end
		return false
	end

	function Features.IsWhitelisted(targetPlayer, mode, target)
		if not targetPlayer or targetPlayer == player then return false end
		if not mode or mode == "Disabled" then return true end

		local name = targetPlayer.Name
		local isSelected = false

		local targetObj = target
		if (not targetObj or (type(targetObj) == "table" and next(targetObj) == nil)) and GlobalWhitelistTable then
			targetObj = GlobalWhitelistTable
		end

		if type(targetObj) == "table" then
			if targetObj[name] == true then
				isSelected = true
			else
				for k, v in pairs(targetObj) do
					if v == name or (k == name and v == true) then
						isSelected = true
						break
					end
				end
			end
		elseif type(targetObj) == "string" and targetObj ~= "" and targetObj ~= "Nadie" then
			isSelected = (targetObj == name or targetObj == "Todos")
		end

		if mode == "Only Whitelist" then
			return isSelected
		elseif mode == "Ignore Whitelist" then
			return not isSelected
		end
		return true
	end

	function Features.IsSameTeam(p)
		if not p or p == player then return true end
		if p.Team and player.Team and p.Team == player.Team then
			return true
		end
		return false
	end

	function Features.IsPlayerValidESP(targetPlayer)
		if not targetPlayer or targetPlayer == player then return false end
		local espCfg = Config.ESP

		local isFriend = Features.IsFriend(targetPlayer)
		-- Friends with FriendCheck ON are ALWAYS valid (bypasses team & whitelist filters)
		if espCfg.FriendCheck and isFriend then
			return true
		end

		-- Whitelist Filtering: "Only Whitelist" bypasses Team Filters for the selected player
		if espCfg.WhitelistMode == "Only Whitelist" then
			return Features.IsWhitelisted(targetPlayer, "Only Whitelist", espCfg.WhitelistTarget)
		end

		if not Features.IsWhitelisted(targetPlayer, espCfg.WhitelistMode, espCfg.WhitelistTarget) then
			return false
		end

		-- Team Filtering
		if Features.IsTeamIgnored(targetPlayer, espCfg.IgnoreTeams) then
			return false
		end

		return true
	end

	function Features.GetESPColor(targetPlayer)
		local espCfg = Config.ESP
		if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
			return Color3.fromRGB(0, 255, 120) -- Green for friends
		end
		if espCfg.RainbowESP or espCfg.Rainbow then
			return Color3.fromHSV((tick() % 4) / 4, 1, 1)
		end
		if espCfg.TeamColorHighlight and targetPlayer.Team and targetPlayer.TeamColor then
			return targetPlayer.TeamColor.Color
		end
		return COLOR_MAP[espCfg.HighlightColor] or COLOR_MAP["Morado"]
	end

	function Features.GetTracerColor(targetPlayer)
		local espCfg = Config.ESP
		if espCfg.FriendCheck and Features.IsFriend(targetPlayer) then
			return Color3.fromRGB(0, 255, 120) -- Green for friends
		end
		if espCfg.RainbowESP or espCfg.Rainbow then
			return Color3.fromHSV((tick() % 4) / 4, 1, 1)
		end
		if espCfg.TeamColorTracers and targetPlayer.Team and targetPlayer.TeamColor then
			return targetPlayer.TeamColor.Color
		end
		return Color3.fromRGB(255, 0, 0) -- RED is standard for tracers
	end

	------------------------------------------------------------- ESP MODULE
	function Features.UpdateESP()
		local espCfg = Config.ESP
		local anyEnabled = espCfg.Highlight or espCfg.Names or espCfg.Details or espCfg.Tracers

		if not anyEnabled then
			if Runtime.ESP.loop then
				Runtime.ESP.loop:Disconnect()
				Runtime.ESP.loop = nil
			end
			for _, entry in pairs(Runtime.ESP.objects) do
				if entry.Highlight then entry.Highlight.Enabled = false end
				if entry.Billboard then entry.Billboard.Enabled = false end
				if entry.Tracer then entry.Tracer.Visible = false end
			end
			return
		end

		if not Runtime.ESP.container then
			local f = Instance.new("Folder")
			f.Name = "RATAHUB_ESP"
			f.Parent = workspace
			Runtime.ESP.container = f
		end

		if not Runtime.ESP.loop then
			Runtime.ESP.loop = RunService.RenderStepped:Connect(function()
				local cam = workspace.CurrentCamera
				if not cam then return end

				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player and p.Character then
						local char = p.Character
						local hum = char:FindFirstChildOfClass("Humanoid")
						local root = char:FindFirstChild("HumanoidRootPart")
						local valid = Features.IsPlayerValidESP(p)

						local entry = Runtime.ESP.objects[p]
						if not entry then
							entry = {}
							Runtime.ESP.objects[p] = entry
						end

						local color = Features.GetESPColor(p)
						local tracerColor = Features.GetTracerColor(p)

						-- 1. Highlight
						if espCfg.Highlight and valid and hum and hum.Health > 0 then
							if not entry.Highlight or entry.Highlight.Parent ~= char then
								if entry.Highlight then entry.Highlight:Destroy() end
								local h = Instance.new("Highlight")
								h.Name = "ESPHighlight"
								h.Adornee = char
								h.FillTransparency = 0.5
								h.OutlineTransparency = 0
								h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								h.Parent = char
								entry.Highlight = h
							end
							entry.Highlight.FillColor = color
							entry.Highlight.OutlineColor = color
							entry.Highlight.Enabled = true
						elseif entry.Highlight then
							entry.Highlight.Enabled = false
						end

						-- 2. Billboard (Names & Details)
						local showText = (espCfg.Names or espCfg.Details) and valid and hum and hum.Health > 0 and root
						if showText then
							if not entry.Billboard then
								local b = Instance.new("BillboardGui")
								b.Name = "ESP_Tag"
								b.Size = UDim2.new(0, 200, 0, 40)
								b.AlwaysOnTop = true
								b.ResetOnSpawn = false

								local l = Instance.new("TextLabel")
								l.Name = "Tag"
								l.Size = UDim2.fromScale(1, 1)
								l.BackgroundTransparency = 1
								l.Font = FONT_BOLD
								l.TextStrokeTransparency = 0.3
								l.TextStrokeColor3 = Color3.new(0, 0, 0)
								l.Parent = b

								b.Parent = Runtime.ESP.container
								entry.Billboard = b
								entry.Label = l
							end

							entry.Billboard.Adornee = root
							entry.Billboard.StudsOffset = Vector3.new(espCfg.OffsetX, 2.5 + espCfg.OffsetY, 0)
							entry.Billboard.Enabled = true
							entry.Label.TextSize = espCfg.TextSize
							entry.Label.TextColor3 = color

							if espCfg.Details then
								local dist = math.floor((cam.CFrame.Position - root.Position).Magnitude)
								local hp = math.floor(hum.Health)
								entry.Label.Text = string.format("%s\n[%d HP] [%d studs]", p.DisplayName, hp, dist)
							else
								entry.Label.Text = p.DisplayName
							end
						elseif entry.Billboard then
							entry.Billboard.Enabled = false
						end

						-- 3. Tracers
						if espCfg.Tracers and valid and hum and hum.Health > 0 and root and Drawing then
							if not entry.Tracer then
								local line = Drawing.new("Line")
								line.Thickness = 1.5
								line.Transparency = 1
								entry.Tracer = line
							end

							local rootPos, onScreen = cam:WorldToViewportPoint(root.Position)
							if onScreen then
								local originPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
								if espCfg.TracerOrigin == "Center" then
									originPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
								elseif espCfg.TracerOrigin == "Mouse" then
									originPos = UserInputService:GetMouseLocation()
								end

								entry.Tracer.From = originPos
								entry.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
								entry.Tracer.Color = tracerColor
								entry.Tracer.Visible = true
							else
								entry.Tracer.Visible = false
							end
						elseif entry.Tracer then
							entry.Tracer.Visible = false
						end
					else
						local entry = Runtime.ESP.objects[p]
						if entry then
							if entry.Highlight then entry.Highlight.Enabled = false end
							if entry.Billboard then entry.Billboard.Enabled = false end
							if entry.Tracer then entry.Tracer.Visible = false end
						end
					end
				end
			end)
		end
	end

	------------------------------------------------------------- AIMLOCK MODULE (RAYFIELD LOGIC)
	function Features.GetAimPart(char)
		if not char then return nil end
		local aimPart = Config.Aimlock.AimPart or "Head"

		if aimPart == "Head" then
			return char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
		elseif aimPart == "Torso" then
			return char:FindFirstChild("UpperTorso")
				or char:FindFirstChild("Torso")
				or char:FindFirstChild("HumanoidRootPart")
				or char:FindFirstChildWhichIsA("BasePart")
		else
			for _, name in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart"}) do
				local p = char:FindFirstChild(name)
				if p then return p end
			end
			return char:FindFirstChildWhichIsA("BasePart")
		end
	end

	local function ClearAimlockHighlight()
		if Runtime.Aimlock.highlight then
			pcall(function() Runtime.Aimlock.highlight:Destroy() end)
			Runtime.Aimlock.highlight = nil
		end
	end

	local function CreateAimlockHighlight(plr)
		ClearAimlockHighlight()
		if not plr or not plr.Character then return end

		local h = Instance.new("Highlight")
		h.Name = "AimlockESP"
		h.Adornee = plr.Character
		h.FillColor = Color3.fromRGB(255, 0, 0)
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.FillTransparency = 0.5
		h.OutlineTransparency = 0
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = plr.Character
		Runtime.Aimlock.highlight = h
	end

	function Features.FindBestAimlockTarget()
		local aimCfg = Config.Aimlock
		local cam = workspace.CurrentCamera
		if not cam then return nil end

		local closestPlayer = nil
		local shortest = math.huge
		local mousePos = UserInputService:GetMouseLocation()

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player
				and Features.IsAlive(plr)
				and Features.IsWhitelisted(plr, aimCfg.WhitelistMode, aimCfg.WhitelistTarget)
			then
				-- Friend Check: never lock friends
				if aimCfg.FriendCheck and Features.IsFriend(plr) then
					continue
				end

				-- If NOT in "Only Whitelist", apply Team Check and Ignore Teams
				if aimCfg.WhitelistMode ~= "Only Whitelist" then
					if aimCfg.TeamCheck and Features.IsSameTeam(plr) then
						continue
					end

					if Features.IsTeamIgnored(plr, aimCfg.IgnoreTeams) then
						continue
					end
				end

				local char = plr.Character
				if not char then continue end

				local part = Features.GetAimPart(char)
				if not part then continue end

				local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
				if not onScreen then continue end

				local worldDist = (cam.CFrame.Position - part.Position).Magnitude
				if aimCfg.UseMaxDistance and worldDist > aimCfg.MaxDistance then
					continue
				end

				local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude

				if aimCfg.UseFOV and dist > aimCfg.FOVSize then
					continue
				end

				if dist < shortest then
					shortest = dist
					closestPlayer = plr
				end
			end
		end

		return closestPlayer
	end

	function Features.UnlockAimlock(reason, targetName)
		Runtime.Aimlock.locked = false
		Runtime.Aimlock.currentTarget = nil
		ClearAimlockHighlight()

		if Runtime.Aimlock.tracer then
			Runtime.Aimlock.tracer.Visible = false
		end

		if reason == "died" and targetName then
			RATAHUB:Notify({ Title = "☠️", Content = targetName .. " se murio el naco💀", Duration = 2 })
		elseif reason == "left" and targetName then
			RATAHUB:Notify({ Title = "Aimlock", Content = targetName .. " se salió/desapareció", Duration = 1.5 })
		end
	end

	function Features.ToggleAimlockLock()
		-- If master toggle is OFF, auto-enable module on keybind press
		if not Config.Aimlock.Enabled then
			Config.Aimlock.Enabled = true
			if Controls.Aimlock and Controls.Aimlock.Toggle then
				Controls.Aimlock.Toggle:SetSilent(true)
			end
			Features.UpdateAimlock()
		end

		if Runtime.Aimlock.locked then
			Features.UnlockAimlock()
			RATAHUB:Notify({ Title = "Aimlock", Content = "Desactivado", Duration = 1.2 })
		else
			local candidate = Features.FindBestAimlockTarget()
			if candidate then
				Runtime.Aimlock.currentTarget = candidate
				Runtime.Aimlock.locked = true
				CreateAimlockHighlight(candidate)

				if Config.Sounds.LockSound and Config.Sounds.LockTargetSound then
					Features.PlaySound(Config.Sounds.LockTargetSound)
				end
				RATAHUB:Notify({ Title = "Aimlock", Content = "Lockeaste a " .. candidate.Name, Duration = 1.5 })
			else
				RATAHUB:Notify({ Title = "Aimlock", Content = "No hay nadie para lockear", Duration = 1.5 })
			end
		end
	end

	function Features.UpdateAimlock()
		local aimCfg = Config.Aimlock
		if not aimCfg.Enabled then
			if Runtime.Aimlock.loop then
				Runtime.Aimlock.loop:Disconnect()
				Runtime.Aimlock.loop = nil
			end
			Features.UnlockAimlock()
			if Runtime.Aimlock.fovCircle then Runtime.Aimlock.fovCircle.Visible = false end
			return
		end

		if not Runtime.Aimlock.loop then
			Runtime.Aimlock.loop = RunService.RenderStepped:Connect(function()
				-- FOV Circle
				if Config.Aimlock.Enabled and Config.Aimlock.UseFOV then
					if not Runtime.Aimlock.fovCircle then
						Runtime.Aimlock.fovCircle = create("Frame", {
							Name = "FOVCircle",
							AnchorPoint = Vector2.new(0.5, 0.5),
							BackgroundTransparency = 1,
							ZIndex = 2,
							Parent = screenGui,
						})
						corner(999, Runtime.Aimlock.fovCircle)
						stroke(Runtime.Aimlock.fovCircle, 0.5, THEME.Primary, 1.5)
					end
					local mPos = UserInputService:GetMouseLocation()
					Runtime.Aimlock.fovCircle.Position = UDim2.fromOffset(mPos.X, mPos.Y)
					Runtime.Aimlock.fovCircle.Size = UDim2.fromOffset(Config.Aimlock.FOVSize * 2, Config.Aimlock.FOVSize * 2)
					Runtime.Aimlock.fovCircle.Visible = true
				else
					if Runtime.Aimlock.fovCircle then Runtime.Aimlock.fovCircle.Visible = false end
				end

				if not Config.Aimlock.Enabled or not Runtime.Aimlock.locked or not Runtime.Aimlock.currentTarget then
					if Runtime.Aimlock.tracer then Runtime.Aimlock.tracer.Visible = false end
					return
				end

				local targetPlayer = Runtime.Aimlock.currentTarget
				local targetName = targetPlayer.Name

				-- Check if target is still in game
				if not targetPlayer.Parent then
					Features.UnlockAimlock("left", targetName)
					return
				end

				-- Check if target is still alive
				if not Features.IsAlive(targetPlayer) then
					Features.PlaySound("CS:GO Headshot")
					Features.UnlockAimlock("died", targetName)
					return
				end

				-- Check whitelist validity
				if not Features.IsWhitelisted(targetPlayer, Config.Aimlock.WhitelistMode, Config.Aimlock.WhitelistTarget) then
					Features.UnlockAimlock()
					return
				end

				local char = targetPlayer.Character
				if not char then
					Features.UnlockAimlock("left", targetName)
					return
				end

				local part = Features.GetAimPart(char)
				local root = char:FindFirstChild("HumanoidRootPart")
				if not part then
					Features.UnlockAimlock("left", targetName)
					return
				end

				local cam = workspace.CurrentCamera
				if not cam then return end

				local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
				local worldDist = (part.Position - cam.CFrame.Position).Magnitude

				if not onScreen or (Config.Aimlock.UseMaxDistance and worldDist > Config.Aimlock.MaxDistance) then
					Features.UnlockAimlock()
					RATAHUB:Notify({ Title = "Aimlock", Content = "Objetivo fuera de rango", Duration = 1.5 })
					return
				end

				-- Prediction
				local targetPos = part.Position
				if Config.Aimlock.Prediction and root then
					local vel = root.AssemblyLinearVelocity or Vector3.zero
					targetPos = targetPos + (vel * Config.Aimlock.PredictionTime)
				end

				-- Camera Lerp (Rayfield logic)
				local targetCF = CFrame.lookAt(cam.CFrame.Position, targetPos)
				local smoothVal = Config.Aimlock.Smoothness
				if type(smoothVal) == "number" then
					if smoothVal > 1 then
						smoothVal = math.clamp(smoothVal / 100, 0.01, 1)
					else
						smoothVal = math.clamp(smoothVal, 0.01, 1)
					end
				else
					smoothVal = 1
				end
				cam.CFrame = cam.CFrame:Lerp(targetCF, smoothVal)

				-- Maintain highlight
				if Runtime.Aimlock.highlight and Runtime.Aimlock.highlight.Adornee ~= char then
					CreateAimlockHighlight(targetPlayer)
				end

				if Runtime.Aimlock.tracer then
					Runtime.Aimlock.tracer.Visible = false
				end
			end)
		end
	end

	--------------------------------------------------------------- TRIGGERBOT MODULE (LAG-FREE OPTIMIZED)
	local TriggerRayParams = RaycastParams.new()
	TriggerRayParams.FilterType = Enum.RaycastFilterType.Exclude

	function Features.SetTriggerbotMaster(enabled)
		Config.Triggerbot.Enabled = enabled
		Features.SetTriggerbotActive(enabled)
	end

	function Features.SetTriggerbotActive(active)
		if active and not Config.Triggerbot.Enabled then return end
		Config.Triggerbot.Active = active
		Runtime.Triggerbot.active = active

		if active then
			if Runtime.Triggerbot.loop then return end
			local isShooting = false

			Runtime.Triggerbot.loop = RunService.RenderStepped:Connect(function()
				if not Config.Triggerbot.Enabled or not Runtime.Triggerbot.active then
					Features.SetTriggerbotActive(false)
					return
				end
				if isShooting then return end

				local mouse = player:GetMouse()
				local target = mouse and mouse.Target
				if not target or not target.Parent then return end

				local model = target.Parent
				if not model:FindFirstChildOfClass("Humanoid") and model.Parent then
					model = model.Parent
				end

				local hum = model:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 or model.Name == player.Name then return end

				local targetPlr = Players:GetPlayerFromCharacter(model)
				if not targetPlr or targetPlr == player then return end

				-- Whitelist Check
				if not Features.IsWhitelisted(targetPlr, Config.Triggerbot.WhitelistMode, Config.Triggerbot.WhitelistTarget) then
					return
				end

				-- Friend Check: never shoot friends
				if Config.Triggerbot.FriendCheck and Features.IsFriend(targetPlr) then
					return
				end

				-- Team Check & Ignore Teams (bypassed if in "Only Whitelist")
				if Config.Triggerbot.WhitelistMode ~= "Only Whitelist" then
					if Config.Triggerbot.TeamCheck and Features.IsSameTeam(targetPlr) then
						return
					end

					if Features.IsTeamIgnored(targetPlr, Config.Triggerbot.IgnoreTeams) then
						return
					end
				end

				-- Wall Check
				if Config.Triggerbot.WallCheck then
					local char = player.Character
					if char then
						TriggerRayParams.FilterDescendantsInstances = { char }
						local cam = workspace.CurrentCamera
						if cam then
							local origin = cam.CFrame.Position
							local dir = (mouse.Hit.Position - origin).Unit * 1500
							local ray = workspace:Raycast(origin, dir, TriggerRayParams)
							if ray and not ray.Instance:IsDescendantOf(model) then
								if ray.Instance.Transparency < 1 and ray.Instance.CanCollide then
									return
								end
							end
						end
					end
				end

				isShooting = true
				task.spawn(function()
					if Config.Sounds.HitSound and Config.Sounds.HitShootSound then
						Features.PlaySound(Config.Sounds.HitShootSound)
					end

					if mouse1click then
						pcall(mouse1click)
					elseif mouse1press and mouse1release then
						pcall(mouse1press)
						task.wait(0.01)
						pcall(mouse1release)
					elseif VirtualUser then
						pcall(function()
							VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
							task.wait(0.01)
							VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
						end)
					end

					local delayMs = Config.Triggerbot.Delay or 0
					local delaySec = math.max(delayMs / 1000, 0.05)
					task.wait(delaySec)
					isShooting = false
				end)
			end)
		else
			if Runtime.Triggerbot.loop then
				Runtime.Triggerbot.loop:Disconnect()
				Runtime.Triggerbot.loop = nil
			end
			Runtime.Triggerbot.isShooting = false
		end
	end

	function Features.ToggleTriggerbotActive()
		if not Config.Triggerbot.Enabled then
			Config.Triggerbot.Enabled = true
			if Controls.Triggerbot and Controls.Triggerbot.Enabled then
				Controls.Triggerbot.Enabled:SetSilent(true)
			end
		end
		Features.SetTriggerbotActive(not Runtime.Triggerbot.active)
		if Runtime.Triggerbot.active then
			RATAHUB:Notify({ Title = "Triggerbot", Content = "Activado", Duration = 1.2 })
		else
			RATAHUB:Notify({ Title = "Triggerbot", Content = "Desactivado", Duration = 1.2 })
		end
	end

