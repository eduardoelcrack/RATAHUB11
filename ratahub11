--=====================================================================
-- CONTROL: COLOR PICKER (HSV square + hue bar; pure Roblox instances)
--=====================================================================
function Tab:CreateColorPicker(cfg)
	cfg = cfg or {}
	local card = self:_ensureCard()
	local color = cfg.Color or Color3.fromRGB(52, 197, 222)
	local h, s, v = color:ToHSV()

	local row = create("Frame", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
		ZIndex = 5,
		Parent = card,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -70, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Color",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		ZIndex = 6,
		Parent = row,
	})

	local preview = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(52, 24),
		BackgroundColor3 = color,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 6,
		Parent = row,
	})
	corner(6, preview)
	stroke(preview, 0.6)

	-- Overlay panel (animates open/closed; never displaces siblings).
	local PANEL_W = 208
	local SV_W, SV_H = 188, 120
	local HUE_H = 14
	local PANEL_H = SV_H + 10 + HUE_H + 20 -- + top/bottom padding (10 each)

	local panel = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0.5, 20),
		Size = UDim2.fromOffset(PANEL_W, 0),
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 20,
		Parent = row,
	})
	corner(10, panel)
	stroke(panel, 0.85)
	padding(panel, 10)

	-- Saturation / Value square.
	local sv = create("Frame", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(SV_W, SV_H),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 21,
		Parent = panel,
	})
	corner(6, sv)
	-- white gradient (left = white -> right = transparent, revealing hue)
	local whiteOverlay = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 22,
		Parent = sv,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = whiteOverlay,
	})
	-- black gradient (top = transparent -> bottom = black)
	local blackOverlay = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 23,
		Parent = sv,
	})
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = blackOverlay,
	})
	local svDot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(s, 0, 1 - v, 0),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 24,
		Parent = sv,
	})
	corner(5, svDot)
	stroke(svDot, 0.1, Color3.fromRGB(0, 0, 0))
	-- transparent interaction surface over the square
	local svBtn = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 25,
		Parent = sv,
	})

	-- Hue bar.
	local hueBar = create("Frame", {
		Position = UDim2.fromOffset(0, SV_H + 10),
		Size = UDim2.fromOffset(SV_W, HUE_H),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 21,
		Parent = panel,
	})
	corner(5, hueBar)
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hueBar,
	})
	local hueDot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(h, 0, 0.5, 0),
		Size = UDim2.fromOffset(4, HUE_H + 4),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 24,
		Parent = hueBar,
	})
	corner(2, hueDot)
	stroke(hueDot, 0.1, Color3.fromRGB(0, 0, 0))
	local hueBtn = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 25,
		Parent = hueBar,
	})

	local handle = {}

	local function refresh(fireCallback)
		local col = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = col
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svDot.Position = UDim2.new(s, 0, 1 - v, 0)
		hueDot.Position = UDim2.new(h, 0, 0.5, 0)
		if fireCallback and cfg.Callback then task.spawn(cfg.Callback, col) end
	end

	-- Reusable drag capture: fires onMove for the initial press and every
	-- subsequent move, then cleans up both connections on release so there
	-- are never leftover input connections.
	local function bindDrag(surface, onMove)
		surface.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			onMove(input.Position)
			local moveConn, endConn
			moveConn = UserInputService.InputChanged:Connect(function(moveInput)
				if moveInput.UserInputType == Enum.UserInputType.MouseMovement
					or moveInput.UserInputType == Enum.UserInputType.Touch then
					onMove(moveInput.Position)
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == Enum.UserInputType.MouseButton1
					or endInput.UserInputType == Enum.UserInputType.Touch then
					if moveConn then moveConn:Disconnect() moveConn = nil end
					if endConn then endConn:Disconnect() endConn = nil end
				end
			end)
		end)
	end

	bindDrag(svBtn, function(pos)
		local relX = clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		local relY = clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		s = relX
		v = 1 - relY
		refresh(true)
	end)

	bindDrag(hueBtn, function(pos)
		local relX = clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
		h = relX
		refresh(true)
	end)

	local open = false
	local function setOpen(o)
		open = o
		if open then panel.Visible = true end
		local t = tween(panel, DROP, { Size = UDim2.fromOffset(PANEL_W, open and PANEL_H or 0) })
		if not open then
			t.Completed:Connect(function()
				if not open then panel.Visible = false end
			end)
		end
	end

	preview.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	function handle:Set(newColor)
		if typeof(newColor) ~= "Color3" then return end
		h, s, v = newColor:ToHSV()
		refresh(true)
	end
	function handle:Get() return Color3.fromHSV(h, s, v) end
	return handle
end

--=====================================================================
-- RAYFIELD COMPATIBILITY ADAPTER
--
-- Lets existing RATAHUB / Rayfield-style code keep calling
-- Tab:CreateToggle{...}, :CreateSlider{...}, etc. with minimal changes.
-- The adapter only forwards config + callbacks into the real UI controls;
-- gameplay logic stays inside the Callback and never touches the UI.
-- Implemented independently (no Rayfield source is copied).
--=====================================================================
local RATAHUBAdapter = {}
RATAHUBAdapter.__index = RATAHUBAdapter

function RATAHUBAdapter.wrap(window)
	return setmetatable({ _window = window }, RATAHUBAdapter)
end

function RATAHUBAdapter:CreateWindow(_)
	-- Rayfield returns a window; here the window already exists.
	return self
end

function RATAHUBAdapter:CreateTab(name, icon)
	local tab = self._window:CreateTab({ Name = name, Icon = icon, SubTitle = name })
	return setmetatable({ _tab = tab }, {
		__index = {
			CreateSection = function(_, t)
				return tab:CreateSection(t)
			end,
			CreateDivider = function(_)
				return tab:CreateDivider()
			end,
			CreateParagraph = function(_, c)
				c = c or {}
				return tab:CreateParagraph({ Title = c.Title, Content = c.Content })
			end,
			CreateLabel = function(_, c)
				local text = type(c) == "table" and c.Text or c
				return tab:CreateLabel({ Text = text })
			end,
			CreateButton = function(_, c)
				c = c or {}
				return tab:CreateButton({
					Name = c.Name, Callback = c.Callback, Destructive = c.Destructive,
				})
			end,
			CreateToggle = function(_, c)
				c = c or {}
				return tab:CreateToggle({
					Name = c.Name, Description = c.Description,
					CurrentValue = c.CurrentValue, Callback = c.Callback,
				})
			end,
			CreateSlider = function(_, c)
				c = c or {}
				return tab:CreateSlider({
					Name = c.Name, Range = c.Range, Increment = c.Increment,
					CurrentValue = c.CurrentValue, Suffix = c.Suffix, Callback = c.Callback,
				})
			end,
			CreateDropdown = function(_, c)
				c = c or {}
				return tab:CreateDropdown({
					Name = c.Name, Options = c.Options,
					CurrentOption = c.CurrentOption or (c.Options and c.Options[1]),
					Callback = c.Callback,
				})
			end,
			CreateKeybind = function(_, c)
				c = c or {}
				return tab:CreateKeybind({
					Name = c.Name, CurrentKeybind = c.CurrentKeybind, Callback = c.Callback,
				})
			end,
			CreateInput = function(_, c)
				c = c or {}
				return tab:CreateInput({
					Name = c.Name, PlaceholderText = c.PlaceholderText,
					CurrentValue = c.CurrentValue, Callback = c.Callback,
				})
			end,
			CreateColorPicker = function(_, c)
				c = c or {}
				return tab:CreateColorPicker({
					Name = c.Name, Color = c.Color, Callback = c.Callback,
				})
			end,
		},
	})
end

function RATAHUBAdapter:Notify(cfg)
	return RATAHUB:Notify(cfg)
end

