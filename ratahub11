	local handle = {}
	local open = false
	local function setOpen(v)
		open = v
		if open then list.Visible = true end
		tween(arrow, DROP, { Rotation = open and 180 or 0 })
		local t = tween(list, DROP, { Size = UDim2.new(0.5, 0, 0, open and listHeight or 0) })
		if not open then
			t.Completed:Connect(function()
				if not open then list.Visible = false end
			end)
		end
	end

	local function choose(opt)
		current = opt
		selectedLabel.Text = tostring(opt)
		setOpen(false)
		if cfg.Callback then task.spawn(cfg.Callback, opt) end
	end

	local function rebuildOptions()
		for _, child in ipairs(inner:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		listHeight = math.min(#options, 5) * 30 + 8
		if open then
			tween(list, DROP, { Size = UDim2.new(0.5, 0, 0, listHeight) })
		end
		for i, opt in ipairs(options) do
			local item = create("TextButton", {
