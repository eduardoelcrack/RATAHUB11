					local newW = clamp(origin.width  + c.signX * dx * 2, MIN_W, MAX_W)
					local newH = clamp(origin.height + c.signY * dy * 2, MIN_H, MAX_H)

					window.Size = UDim2.fromOffset(newW, newH)
					if self._currentDropdownReposition then
						self._currentDropdownReposition()
					end
				end)

				endConn = UserInputService.InputEnded:Connect(function(endInput)
					if endInput.UserInputType == Enum.UserInputType.MouseButton1
						or endInput.UserInputType == Enum.UserInputType.Touch then
						stopResize()
					end
				end)
			end)
		end

		--------------------------------------------------------------
		-- DRAG (PROTECTED — Zero-jump Drag)
		--------------------------------------------------------------
		do
			local dragging = false
			local dragStartX, dragStartY
			local startScaleX, startOffX
			local startScaleY, startOffY
			local moveConn, endConn

			local function stopDrag()
				dragging = false
				dragActive = false
				if moveConn then moveConn:Disconnect() moveConn = nil end
				if endConn then endConn:Disconnect() endConn = nil end
			end

			topBar.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseButton1
					and input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end
				if dragging or resizeActive then return end

				dragging = true
				dragActive = true
				dragStartX, dragStartY = input.Position.X, input.Position.Y
				local p = window.Position
				startScaleX, startOffX = p.X.Scale, p.X.Offset
				startScaleY, startOffY = p.Y.Scale, p.Y.Offset

				moveConn = UserInputService.InputChanged:Connect(function(moveInput)
					if not dragging then return end
					if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
						and moveInput.UserInputType ~= Enum.UserInputType.Touch then
						return
					end
					local dx = moveInput.Position.X - dragStartX
					local dy = moveInput.Position.Y - dragStartY
					window.Position = UDim2.new(
						startScaleX, startOffX + dx,
						startScaleY, startOffY + dy
					)
					if self._currentDropdownReposition then
						self._currentDropdownReposition()
					end
				end)

				endConn = UserInputService.InputEnded:Connect(function(endInput)
					if endInput.UserInputType == Enum.UserInputType.MouseButton1
						or endInput.UserInputType == Enum.UserInputType.Touch then
						stopDrag()
					end
				end)
			end)
		end

