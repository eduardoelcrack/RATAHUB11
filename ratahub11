--=====================================================================
local Features = {}

local function getChar() return player.Character end
local function getHumanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

------------------------------------------------------------- Movement: Fly
function Features.StopFly()
	Runtime.Fly.active = false
	if Runtime.Fly.loop then Runtime.Fly.loop:Disconnect() Runtime.Fly.loop = nil end
	if Runtime.Fly.bv then Runtime.Fly.bv:Destroy() Runtime.Fly.bv = nil end
	if Runtime.Fly.bg then Runtime.Fly.bg:Destroy() Runtime.Fly.bg = nil end
	local char = getChar()
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.PlatformStand = false end
		if Runtime.Fly.animate then
			Runtime.Fly.animate.Parent = char
			Runtime.Fly.animate = nil
		end
	end
end

function Features.StartFly()
	local char = getChar()
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char.HumanoidRootPart
	if hum then hum.PlatformStand = true end
	if char:FindFirstChild("Animate") then
		Runtime.Fly.animate = char.Animate:Clone()
		char.Animate:Destroy()
	end
	Runtime.Fly.bv = Instance.new("BodyVelocity")
	Runtime.Fly.bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	Runtime.Fly.bv.Velocity = Vector3.zero
	Runtime.Fly.bv.Parent = root
	Runtime.Fly.bg = Instance.new("BodyGyro")
	Runtime.Fly.bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	Runtime.Fly.bg.P = 20000
	Runtime.Fly.bg.D = 800
	Runtime.Fly.bg.Parent = root
	Runtime.Fly.active = true
	Runtime.Fly.loop = RunService.RenderStepped:Connect(function()
		if not Runtime.Fly.active then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local look = cam.CFrame.LookVector
		local right = look:Cross(Vector3.new(0, 1, 0))
		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += look end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= look end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += right end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
		Runtime.Fly.bv.Velocity = move * Config.Main.Movement.FlySpeed
		Runtime.Fly.bg.CFrame = cam.CFrame
	end)
end

function Features.ToggleFly()
	Config.Main.Movement.Fly = not Config.Main.Movement.Fly
	if Controls.Main.Fly then
		Controls.Main.Fly:Set(Config.Main.Movement.Fly)
	end
	if Config.Main.Movement.Fly then
		Features.StartFly()
		RATAHUB:Notify({ Title = "Fly", Content = "Activado", Duration = 1.2 })
	else
		Features.StopFly()
		RATAHUB:Notify({ Title = "Fly", Content = "Desactivado", Duration = 1.2 })
	end
end

------------------------------------------------------------- Movement: WalkSpeed
function Features.StartWalkSpeed()
	if Runtime.WalkSpeed.loop then return end
	Runtime.WalkSpeed.loop = RunService.RenderStepped:Connect(function()
		local hum = getHumanoid()
		if not hum then return end
		if not Runtime.WalkSpeed.original then Runtime.WalkSpeed.original = hum.WalkSpeed end
		local desired = Runtime.WalkSpeed.active and Config.Main.Movement.WalkSpeed
			or (Runtime.WalkSpeed.original or 16)
		if hum.WalkSpeed ~= desired then hum.WalkSpeed = desired end
	end)
end

function Features.StopWalkSpeed()
	if Runtime.WalkSpeed.loop then Runtime.WalkSpeed.loop:Disconnect() Runtime.WalkSpeed.loop = nil end
	local hum = getHumanoid()
	if hum and Runtime.WalkSpeed.original then hum.WalkSpeed = Runtime.WalkSpeed.original end
end

function Features.ToggleWalkSpeed()
	if not Config.Main.Movement.WalkSpeedEnabled then return end
	Runtime.WalkSpeed.active = not Runtime.WalkSpeed.active
