		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0.45, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Dropdown",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		ZIndex = 6,
		Parent = row,
	})

	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.5, 0, 0, 30),
		BackgroundColor3 = THEME.Secondary,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 6,
		Parent = row,
	})
	corner(8, btn)
	stroke(btn, 0.9)
	padding(btn, nil, 12, 10, 0, 0)
	local selectedLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -20, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(current),
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 13,
		ZIndex = 7,
		Parent = btn,
	})
	local arrow = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		Text = "▾",
		TextColor3 = THEME.Muted,
		Font = FONT, TextSize = 12,
		ZIndex = 7,
		Parent = btn,
	})

	local listHeight = math.min(#options, 5) * 30 + 8
	local list = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0.5, 18),
		Size = UDim2.new(0.5, 0, 0, 0),
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 20,
		Parent = row,
	})
	corner(8, list)
	stroke(list, 0.85)
	padding(list, 4)
	create("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	-- Long option lists remain usable: the visible list caps at 5 rows and
	-- scrolls internally, so the overlay never grows past a sane height.
	local inner = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = THEME.Stroke,
		ScrollBarImageTransparency = 0.6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 21,
		Parent = list,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = inner,
	})

	local handle = {}
	local open = false
	local function setOpen(v)
		open = v
		if open then list.Visible = true end
		tween(arrow, DROP, { Rotation = open and 180 or 0 })
		local t = tween(list, DROP, { Size = UDim2.new(0.5, 0, 0, open and listHeight or 0) })
		if not open then
			t.Completed:Connect(function()
				if not open then list.Visible = false end
			end)
		end
	end

	local function choose(opt)
		current = opt
		selectedLabel.Text = tostring(opt)
		setOpen(false)
		if cfg.Callback then task.spawn(cfg.Callback, opt) end
	end

	for i, opt in ipairs(options) do
		local item = create("TextButton", {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundColor3 = THEME.Secondary,
			BackgroundTransparency = 1,
			Text = tostring(opt),
			TextColor3 = THEME.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = FONT, TextSize = 13,
			AutoButtonColor = false,
			ZIndex = 22,
			Parent = inner,
		})
		corner(6, item)
		padding(item, nil, 10, 6, 0, 0)
		item.MouseEnter:Connect(function()
			tween(item, HOVER, { BackgroundTransparency = 0.85, TextColor3 = THEME.Foreground })
		end)
		item.MouseLeave:Connect(function()
			tween(item, HOVER, { BackgroundTransparency = 1, TextColor3 = THEME.Muted })
		end)
		item.MouseButton1Click:Connect(function()
			choose(opt)
		end)
	end

	btn.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	function handle:Set(v)
		-- Guard against invalid values: only accept options that exist.
		for _, o in ipairs(options) do
			if o == v then
				choose(v)
				return
			end
		end
		-- Unknown value: leave the current selection untouched.
	end
	function handle:Get() return current end
	return handle
end

--=====================================================================
-- CONTROL: KEYBIND (generic; click -> "Press a key..." -> capture)
--=====================================================================
function Tab:CreateKeybind(cfg)
	cfg = cfg or {}
	local card = self:_ensureCard()
	local currentKey = cfg.CurrentKeybind or "None"

	local row = create("Frame", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -110, 1, 0),
		BackgroundTransparency = 1,
		Text = cfg.Name or "Keybind",
		TextColor3 = THEME.Foreground,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = FONT, TextSize = 14,
		Parent = row,
	})
	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(100, 28),
		BackgroundColor3 = THEME.Secondary,
		Text = tostring(currentKey),
		TextColor3 = THEME.Foreground,
		Font = FONT_MONO, TextSize = 12,
		AutoButtonColor = false,
		Parent = row,
	})
	corner(8, btn)
	stroke(btn, 0.9)
	attachInteract(btn, { hover = 1.03, press = 0.96 })

	local handle = {}
	local listening = false
	local captureConn

	local function stopListening()
		listening = false
		if captureConn then captureConn:Disconnect() captureConn = nil end
	end

	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		btn.Text = "Press a key..."
		tween(btn, HOVER, { BackgroundColor3 = THEME.Primary })
		btn.TextColor3 = THEME.PrimaryText

		captureConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			-- ignore GUI-directed input like the click that opened this
			if gameProcessed then return end

			if input.KeyCode == Enum.KeyCode.Escape then
				-- cancel: restore previous key
				stopListening()
				btn.Text = tostring(currentKey)
				tween(btn, HOVER, { BackgroundColor3 = THEME.Secondary })
				btn.TextColor3 = THEME.Foreground
				return
			end

			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
				currentKey = input.KeyCode.Name
				stopListening()
				btn.Text = currentKey
				tween(btn, HOVER, { BackgroundColor3 = THEME.Secondary })
				btn.TextColor3 = THEME.Foreground
				if cfg.Callback then task.spawn(cfg.Callback, input.KeyCode) end
			end
		end)
	end)

	function handle:Set(keyName)
		-- Accept a KeyCode enum or a plain name string.
		if typeof(keyName) == "EnumItem" then
			keyName = keyName.Name
		end
		currentKey = keyName
		btn.Text = tostring(keyName)
	end
	function handle:Get() return currentKey end
	return handle
end

--=====================================================================
-- CONTROL: BUTTON  (UIScale press feedback)
--=====================================================================
function Tab:CreateButton(cfg)
	cfg = cfg or {}
	local card = self:_ensureCard()
	local destructive = cfg.Destructive and true or false

	local btn = create("TextButton", {
		LayoutOrder = self:_cardOrder(card),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = destructive and THEME.Destructive or THEME.Secondary,
		BackgroundTransparency = destructive and 0.85 or 0,
		Text = cfg.Name or "Button",
		TextColor3 = destructive and THEME.Destructive or THEME.Foreground,
		Font = FONT_BOLD, TextSize = 13,
		AutoButtonColor = false,
		Parent = card,
	})
	corner(10, btn)
	if destructive then stroke(btn, 0.6, THEME.Destructive) end
	attachInteract(btn, {
		hover = 1.015,
		press = 0.97,
		onHover = function(isIn)
			if not destructive then
				tween(btn, HOVER, { BackgroundColor3 = isIn and THEME.Primary or THEME.Secondary })
				tween(btn, HOVER, { TextColor3 = isIn and THEME.PrimaryText or THEME.Foreground })
			else
				tween(btn, HOVER, { BackgroundTransparency = isIn and 0.7 or 0.85 })
			end
		end,
	})

	local handle = {}
	btn.MouseButton1Click:Connect(function()
		if cfg.Callback then task.spawn(cfg.Callback) end
	end)
	function handle:SetText(t) btn.Text = tostring(t) end
	function handle:GetText() return btn.Text end
	return handle
end

