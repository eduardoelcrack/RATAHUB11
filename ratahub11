		Accent     = Color3.fromRGB(64, 168, 255),
		AccentDim  = Color3.fromRGB(45, 110, 175),
	}

	-- ============================================================
	-- FUNCIÓN PRINCIPAL
	-- ============================================================
	local function CreateRATAHUBLoader()
		local Loader = {}
		local hiddenMainGui = nil
        local guiWatchConnection = nil

		-- Estado interno explícito: evita combinaciones inconsistentes
